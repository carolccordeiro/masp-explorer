{
  "rewrites": [{ "source": "/((?!assets|models|museums|fonts|icons|.*\\..*).*)", "destination": "/index.html" }],
  "headers": [
    { "source": "/models/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/museums/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] }
  ]
}
